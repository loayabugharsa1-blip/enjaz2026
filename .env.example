# Supabase — انسخ من لوحة تحكم Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# مفتاح توقيع جلسات المستخدمين (64 حرفاً عشوائياً بالنظام الست عشري)
# أنشئه بـ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-64-char-hex

# اختياري: مفتاح خدمة Supabase (صلاحية كاملة) — إذا لم تضعه، سيستخدم المفتاح العام (anon key) كاحتياطي
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
