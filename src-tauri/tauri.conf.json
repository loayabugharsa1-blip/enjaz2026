{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/dev/crates/tauri-config-schema/schema.json",
  "productName": "انجاز للدعاية و الاعلان",
  "version": "2.4.0",
  "identifier": "com.enjaz.advertising.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "if exist \"app\\api\\ping\\route.ts\" move \"app\\api\\ping\\route.ts\" \"app\\api\\ping\\route.ts.bak\" >nul & set BUILD_TARGET=tauri && npm run build && if exist \"app\\api\\ping\\route.ts.bak\" move \"app\\api\\ping\\route.ts.bak\" \"app\\api\\ping\\route.ts\" >nul",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "إنجاز للدعاية و الاعلان",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
